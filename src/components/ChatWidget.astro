---
/**
 * GoHighLevel chat via WM4D's hosted loader
 * (github.com/Web-Marketing-for-Dentists/ghl-chat).
 *
 * v1.js loads the GHL widget, opens it once per session, tags the first
 * message with the landing URL, and hides GHL's bubble below 900px, where the
 * mobile bar's Chat button ([data-chat-open]) opens it instead. It must be
 * present on every page — BaseLayout renders this before the site script.
 *
 * `is:inline` so Astro emits the tag verbatim instead of bundling it.
 */
---

<script
  is:inline
  defer
  src="https://ghl-chat.whitney-fad.workers.dev/v1.js"
  data-ghl-widget-id="6ae0f05c8147ba697cbb0bfe"
  data-auto-open="true"
  data-hide-bubble-below="900"
></script>
