---
/**
 * Site header. Mirrors the markup currently hand-written in public/*.html.
 *
 * The red call strip sits OUTSIDE <header> on purpose: it scrolls away so the
 * sticky bar stays ~88px on mobile instead of ~230px. The fixed bottom bar in
 * BaseLayout keeps "Call Us" reachable at all times.
 */
export interface Props {
  /** "/" on sub-pages, "#top" on the single-page homepage */
  homeHref?: string;
  /** Nav is anchor-only today; sub-pages prefix links with "/" */
  anchorPrefix?: string;
}

const { homeHref = '/', anchorPrefix = homeHref === '/' ? '' : '/' } = Astro.props;

const navItems = [
  { label: 'Home',                     href: `${anchorPrefix}#top` },
  { label: 'Pinhole Gum Rejuvenation', href: `${anchorPrefix}#pinhole` },
  { label: 'Gum Recession',            href: `${anchorPrefix}#gum-recession` },
  { label: 'Research',                 href: `${anchorPrefix}#research` },
  { label: 'Before & After',           href: `${anchorPrefix}#gallery` },
  { label: 'Testimonials',             href: `${anchorPrefix}#testimonials` },
  { label: 'Meet the Doctor',          href: `${anchorPrefix}#doctor` },
  { label: 'FAQ',                      href: `${anchorPrefix}#faq` },
  { label: 'Contact Us',               href: `${anchorPrefix}#contact` },
];

const PHONE_HREF = 'tel:+16265482891';
const PHONE_TEXT = '(626) 548-2891';
const MAP_URL = 'https://maps.app.goo.gl/HzuGehVNjGA5vHPR9';
---

<div class="header-callbar">
  <a href={PHONE_HREF}>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z"/></svg>
    {PHONE_TEXT}
  </a>
</div>

<header class="site-header">
  <div class="shell header-main">
    <a class="header-logo" href={homeHref} aria-label="Chao Pinhole home">
      <img src="/assets/img/logo.webp" alt="Chao Pinhole" width="150" height="207" fetchpriority="high" />
    </a>

    <a class="header-meta" href={MAP_URL} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
      <span>100 South 1st Street<br />Alhambra, CA 91801</span>
    </a>

    <div class="header-actions">
      <a class="btn btn--rose" href={PHONE_HREF}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z"/></svg>
        {PHONE_TEXT}
      </a>
      <a class="btn" href={`${anchorPrefix}#book`}>Book Appointment</a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="primary-nav" id="primary-nav" data-open="false" aria-label="Primary">
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href} set:html={item.label} /></li>
      ))}
    </ul>
  </nav>
</header>
