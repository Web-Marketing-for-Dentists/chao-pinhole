# Cloudflare Pages redirects. Static rules first, then dynamic (splat) rules.
#
# Destinations are EXTENSIONLESS on purpose. Pages 301s /foo.html -> /foo by
# itself, so pointing these at /privacy-policy.html would make every hit take
# two redirects instead of one.

# Old WordPress URLs -> their static equivalents
/privacy-policy/            /privacy-policy            301
/terms-and-conditions/      /terms-and-conditions      301
/disclaimer/                /disclaimer                301
/thank-you/                 /thank-you                 301
/gallery/                   /#gallery                  301

# Retired WordPress endpoints
/wp-login.php               /                          301
/feed/                      /                          301
/comments/feed/             /                          301
/xmlrpc.php                 /                          301

# Dynamic (splat) rules last
/wp-admin/*                 /                          301
/wp-content/*               /                          301
/wp-includes/*              /                          301
